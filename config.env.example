# ============================================================
# LabelPrint 配置示例
# 复制一份再改：cp config.env.example config.env
# 修改后执行：docker compose up -d（env_file 变了会自动重建容器）
# ============================================================

# ---------- 服务配置 ----------
# 访问令牌：网页 ?token= 与 API 鉴权都用它，务必改成自己的随机字符串
LABEL_PRINT_TOKEN=please-change-me-to-a-random-string
# 服务监听端口（host 网络模式；反向代理指向 127.0.0.1:端口）
LABEL_PRINT_PORT=7900
# 开发热重载：true 时改完 app/ static/ scripts/ 下的文件自动生效，不用重新 build
# 生产环境建议 false（改 false 后需 docker restart label-print 才生效）
LABEL_PRINT_RELOAD=false

# ---------- 打印机配置 ----------
# 打印机设备节点。多打印机时强烈建议用 udev 固定名字（见 README），
# 单打印机一般就是 /dev/usb/lp0
LABEL_PRINT_DEVICE=/dev/usb/lp0
# 中文编码：爱宝 A5870 一般用 GBK；乱码时依次尝试 gb18030 / utf-8
LABEL_PRINT_ENCODING=gbk
# 对齐方式：0=靠左 1=居中 2=靠右（网页上可临时改）
LABEL_PRINT_ALIGN=0
# 默认字号倍率：1~6（1 最小，6 最大；网页上可临时改）
LABEL_PRINT_SIZE=2
# 末尾空白行数（方便手撕，网页上可 0~12 临时调）
# 4 行 ≈ 12mm；若出纸后最后一行仍没从机器里露出来，继续调大
LABEL_PRINT_FEED=4
# 字符度量（点）：58mm 纸 1x 一行 32 个半角数字 → 384/32 = 12，字符高 24
# 换机器请实测：打一行数字数一数，WIDTH ÷ 个数 = CHAR_W
LABEL_PRINT_CHAR_W=12
LABEL_PRINT_CHAR_H=24
# 额外行距（点）与左右物理边距（点，两侧合计）
# 0 = 用打印机默认行距（推荐）；填正数表示在此之后再额外加这么多点
# 不要指望用 0 之外的怪值省纸：空行走纸完全靠行距，行距设成 0 点会让末尾空白行失效
LABEL_PRINT_LINE_SPACING=0
LABEL_PRINT_MARGIN=0
# 打印脚本路径（容器内固定，一般不用改）
LABEL_PRINT_SCRIPT=/app/scripts/print_label.sh
LABEL_PRINT_IMAGE_SCRIPT=/app/scripts/print_image.sh
LABEL_PRINT_JOB_SCRIPT=/app/scripts/print_job.sh
# 文字段与图片段之间的空行
LABEL_PRINT_GAP=1
# 单次写入设备的超时秒数（图片建议大一点）
LABEL_PRINT_TIMEOUT=60

# ---------- 图片打印配置 ----------
# 打印宽度（点）：58mm 纸=384，80mm 纸=576
LABEL_PRINT_WIDTH=384
# 二值化阈值 0~255，越大越白（线条图/二维码建议 150 左右）
LABEL_PRINT_THRESHOLD=150
# 默认是否用抖动：false=阈值(线条清晰) true=灰度抖动(照片)
LABEL_PRINT_DITHER=false
# 单张图片大小上限(MB) 与最大打印高度(点，超过会等比缩小)
LABEL_PRINT_MAX_IMAGE_MB=8
LABEL_PRINT_MAX_HEIGHT=1500

# ---------- 时间戳配置 ----------
# 是否默认打印当前时间（网页上可临时改）
LABEL_PRINT_TS_ENABLE=false
# 位置：top=最上面 bottom=最下面（时间戳与正文之间不留空行）
LABEL_PRINT_TS_POS=bottom
# 格式：datetime / datetime_min / cn_full / cn_short / date / time / compact
LABEL_PRINT_TS_FORMAT=datetime
# 时间戳字号倍率（1 最省纸）
LABEL_PRINT_TS_SIZE=1

# ---------- 日志配置 ----------
# 日志落盘路径（容器内 /var/log 已挂载到宿主机 ./logs）
LABEL_PRINT_LOG=/var/log/label-print.log
# 说明：/logs 接口已改为分页（?page=1&page_size=10），不再需要配置条数上限
